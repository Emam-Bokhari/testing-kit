{
  "name": "performance-tester",
  "version": "1.0.0",
  "description": "Minimal performance testing microservice for Express + TypeScript backends",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node init && ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "node init && tsc",
    "start": "node init && node dist/server.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ts-morph": "^28.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
